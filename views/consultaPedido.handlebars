
  <h1>Consulta de Pedido</h1>

  <form action="#" method="POST">

    <label for="codigo">Código do pedido:</label><br>
    <input type="text" id="codigo" name="codigo" value="{{pedidoPlano.codigo}}" readonly size="2"><br><br>

    <label for="data_criacao">Data de cadastro:</label><br>
    <input type="text" id="data_criacao" name="data_criacao" value="{{pedidoPlano.data_criacao}}" readonly maxlength="10" size="10"><br><br>

    <label for="preco_total">Preço total:</label><br>
    <input type="text" id="preco_total" name="preco_total" value="{{pedidoPlano.preco_total}}" readonly maxlength="100" size="50"><br><br>

    <fieldset>
      <legend>Dados do cliente:</legend>

          <label for="cliente_nome">Nome:</label><br>
          <input type="text" id="cliente_nome" name="cliente_nome" value="{{pedidoPlano.cliente_nome}}" readonly maxlength="100" size="50"><br><br>

          <label for="cliente_cpf_cnpj">CPF/CNPJ:</label><br>
          <input type="text" id="cliente_cpf_cnpj" name="cliente_cpf_cnpj" value="{{pedidoPlano.cliente_cpf_cnpj}}" readonly maxlength="25" size="25"><br><br>

          <label for="cliente_telefone">Enderereço:</label><br>
          <input type="text" id="cliente_telefone" name="cliente_telefone" value="{{pedidoPlano.cliente_telefone}}" readonly maxlength="15" size="15"><br><br>
    </fieldset>          

  <br />

    <fieldset>
      <legend>Dados para entrega:</legend>
          
          <label for="entrega_destinatario_nome">Nome do destinatário:</label><br>
          <input type="text" id="entrega_destinatario_nome" name="entrega_destinatario_nome" value="{{pedidoPlano.entrega_destinatario_nome}}" readonly size="50"><br><br>

          <label for="entrega_destinatario_endereco">Endereço:</label><br>
          <input type="text" id="entrega_destinatario_endereco" name="entrega_destinatario_endereco" value="{{pedidoPlano.entrega_destinatario_endereco}}" readonly size="50"><br><br>

          <label for="entrega_data_horario">Data e horário:</label><br>
          <input type="text" id="entrega_data_horario" name="entrega_data_horario" value="{{pedidoPlano.entrega_data_horario}}" readonly size="50"><br><br>

          {{#if pedidoPlano.frete_opcao}}
          <label>Opção de Frete Escolhida:</label><br>
          <input type="text" value="{{pedidoPlano.frete_opcao}} (R$ {{pedidoPlano.frete_preco}})" readonly size="50"><br><br>

          <label>Melhor Envio - Status de Emissão:</label><br>
          {{#if pedidoPlano.frete_link_impressao}}
            <span style="color: green; font-weight: bold;">Etiqueta Gerada!</span><br><br>
            <a href="{{pedidoPlano.frete_link_impressao}}" target="_blank" style="padding: 8px 15px; background: #000; color: #fff; text-decoration: none; display: inline-block; font-weight: bold; border: 1px solid #000;">Visualizar Etiqueta (PDF)</a><br><br>
          {{else}}
            <span style="color: #d32f2f; font-weight: bold;">Etiqueta não emitida</span><br><br>
            <button type="button" id="btn-emitir" onclick="emitirEtiqueta({{pedidoPlano.codigo}})" style="padding: 8px 15px; background: #fff; color: #000; font-weight: bold; border: 2px solid #000; cursor: pointer;">Emitir Etiqueta de Envio</button><br><br>
          {{/if}}
          {{/if}}
    </fieldset>      

    <br />

    <h3>Lista de Produtos</h3>

      <table border="1">
        <tr>
          <td><b>Código</b></td>
          <td><b>Nome</b></td>
        </tr>

        {{#each listaProdutosCestaBDPlanos}}
        <tr>
          <td>{{codigo}}</td>
          <td>
              {{#contains nome "cesta"}}
                <font color='blue'>{{nome}}</font>
              {{else}}
                {{nome}}
              {{/contains}}
          </td>      
        </tr>
        {{/each}}

      </table>

      <br />


  </form>

<script>
async function emitirEtiqueta(codigo) {
    const btn = document.getElementById('btn-emitir');
    if (!confirm('Deseja realmente debitar do saldo sandbox e emitir a etiqueta no Melhor Envio?')) return;

    btn.innerText = 'Processando Emissão...';
    btn.disabled = true;

    try {
        const res = await fetch(`/pedidos/emitir-etiqueta/${codigo}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });

        const data = await res.json();
        if (res.ok) {
            alert('Etiqueta gerada com sucesso! Abrindo link de impressão.');
            window.open(data.url, '_blank');
            window.location.reload();
        } else {
            alert('Erro ao emitir etiqueta: ' + (data.erro || 'Desconhecido'));
        }
    } catch (err) {
        alert('Erro ao se conectar ao servidor.');
    } finally {
        btn.innerText = 'Emitir Etiqueta de Envio';
        btn.disabled = false;
    }
}
</script>
